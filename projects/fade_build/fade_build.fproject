{
  /* Metadata about the Fade Build project */
  "name": "Fade Build",
  "description": "Build system generator for the Fade Framework",
  "version": "0.0.1",

  /* 
   * The entry module implementation for this application, if left empty or omitted the default for the current platform will be used.
   * This will always be configured to the "entry" module.
   */
  "entry_module_implementation": null,

  /*
   * The application module implementation for this application, this should *never* be left empty, or be omitted.
   * This will only work with implementations that implement the "interface" module.
   * We can also specify a parent implementation here if we want to extend an existing implementation.
   */
  "application_module": {
    "implementation": "fade_build",
    "parent_implementation": null
  }
}